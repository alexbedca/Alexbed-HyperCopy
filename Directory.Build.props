<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.4</Version>
    <Product>Alexbed HyperCopy</Product>
    <Company>Alexbed</Company>
    <Authors>Alexander Bediako</Authors>
    <Copyright>Copyright © 2026 Alexander Bediako</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alexbedca/Alexbed-HyperCopy</RepositoryUrl>
    <Description>Ultra-fast portable file copier and mover for Windows.</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
