<Window x:Class="Alexbed.HyperCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Alexbed.HyperCopy.App"
        xmlns:core="clr-namespace:Alexbed.HyperCopy.Core;assembly=Alexbed.HyperCopy.Core"
        Title="Alexbed HyperCopy" Width="1160" Height="740" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        WindowStyle="None" ResizeMode="CanResize" AllowDrop="True"
        Icon="pack://application:,,,/Assets/AlexbedHyperCopy.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        InputMethod.IsInputMethodEnabled="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <local:EnumToBoolConverter x:Key="EnumBool"/>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- ambient glow -->
            <Ellipse Grid.RowSpan="2" Width="700" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-200,0" Opacity="0.16" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4060FF" Offset="0"/>
                        <GradientStop Color="#004060FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>


            <!-- ── Title bar ── -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Alexbed" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Margin="11,0,0,1" VerticalAlignment="Center"/>
                    <TextBlock Text=" HyperCopy" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentH}" Margin="0,0,0,1" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.0" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimize">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximize">
                        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Close">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Content ── -->
            <Grid Grid.Row="1" Margin="20,6,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════ Left: job setup ═══════════ -->
                <Grid Grid.Column="0" IsEnabled="{Binding IsEditable}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sources -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Style="{StaticResource GhostButton}" Click="AddFiles_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,7,0" FontSize="13"/>
                                            <TextBlock Text="Add files"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="AddFolder_Click" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,7,0" FontSize="13"/>
                                            <TextBlock Text="Add folder"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="Clear_Click" ToolTip="Remove all" Padding="9,7">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Source" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding SourcesSummary}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- drop zone -->
                            <Border Grid.Row="1" x:Name="DropZone" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Stroke}" Background="{StaticResource Bg}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasSources, Converter={x:Static local:MainWindow.InverseBoolToVis}}" x:Name="DropHint">
                                        <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource Surface2}" HorizontalAlignment="Center">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource AccentSolid}"/>
                                        </Border>
                                        <TextBlock Text="Drag &amp; drop files or folders here" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="or use Add files / Add folder — whole drives work too" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <ListBox x:Name="SourceList" ItemsSource="{Binding Sources}" Style="{StaticResource PlainList}" Margin="6">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:SourceEntry}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="RemoveSource_Click" Tag="{Binding}" ToolTip="Remove">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11"/>
                                                    </Button>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Surface2}" Margin="0,0,12,0">
                                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5AA9FF"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Destination -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DestinationInfo}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Text="Destination" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="Browse_Click" Margin="8,0,0,0" Padding="14,9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,7,0" FontSize="13"/>
                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="DestinationBox" InputMethod.IsInputMethodEnabled="True" Style="{StaticResource PathBox}" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                            </DockPanel>
                            <DockPanel Margin="2,10,0,0" Visibility="{Binding DestinationProblem, Converter={x:Static local:MainWindow.NonEmptyToVis}}">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warning}"
                                           FontSize="13" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding DestinationProblem}" Foreground="{StaticResource Warning}" FontSize="12.5" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Grid.Row="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="OPERATION" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <Border Style="{StaticResource SegmentHost}">
                                    <UniformGrid Rows="1" Width="210">
                                        <RadioButton Style="{StaticResource BigSegment}" GroupName="mode"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:TransferMode.Copy}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                <TextBlock Text="Copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource BigSegment}" GroupName="mode"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:TransferMode.Move}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8DE;" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                <TextBlock Text="Move" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="IF A FILE ALREADY EXISTS" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="conflict" Content="Skip identical" ToolTip="Skip files with the same size and date (lets you resume an interrupted job). Different files are replaced."
                                                     IsChecked="{Binding Conflict, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:ConflictPolicy.SkipIdentical}}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="conflict" Content="Replace"
                                                     IsChecked="{Binding Conflict, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:ConflictPolicy.Overwrite}}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="conflict" Content="Skip"
                                                     IsChecked="{Binding Conflict, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:ConflictPolicy.Skip}}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="conflict" Content="Keep both"
                                                     IsChecked="{Binding Conflict, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:ConflictPolicy.KeepBoth}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="SAFETY" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Verify}" Margin="2,0,0,4"
                                          ToolTip="After writing, every file is read back from the disk and its XXH3 checksum compared with the source.">
                                    <TextBlock Text="Verify checksums" FontSize="13"/>
                                </CheckBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="SPEED PROFILE" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="Auto-detect" ToolTip="Detects SSD, HDD, USB and network drives and tunes threads and buffers for them."
                                                     IsChecked="{Binding Profile, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:PerformanceProfile.Auto}}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="SSD / NVMe"
                                                     IsChecked="{Binding Profile, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:PerformanceProfile.SolidState}}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="profile" Content="HDD / USB"
                                                     IsChecked="{Binding Profile, Converter={StaticResource EnumBool}, ConverterParameter={x:Static core:PerformanceProfile.Rotational}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Grid.Row="6" Style="{StaticResource PrimaryButton}" Click="Start_Click" IsEnabled="{Binding CanStart}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding StartLabel}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ═══════════ Right: dashboard ═══════════ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <!-- Welcome -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Ready when you are" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,6"/>
                            <TextBlock Text="Pick what to transfer and where. HyperCopy tunes itself to your drives." HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                            <StackPanel Margin="10,30,10,0" MaxWidth="380">
                                <StackPanel.Resources>
                                    <Style TargetType="Border" x:Key="Tip">
                                        <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                        <Setter Property="Padding" Value="14,11"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Border Style="{StaticResource Tip}">
                                    <DockPanel>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="#00C6FF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Unbuffered, pipelined I/O keeps the drive saturated without flooding your RAM." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Tip}">
                                    <DockPanel>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" Foreground="#6A7CFF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Moves on the same drive are instant — even for terabytes." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Tip}">
                                    <DockPanel>
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" Foreground="#A35BFF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Interrupted? Run the same job again — identical files are skipped." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dashboard -->
                        <Grid Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Surface2}" CornerRadius="7" Padding="9,4" VerticalAlignment="Center"
                                        Visibility="{Binding Route, Converter={x:Static local:MainWindow.NonEmptyToVis}}">
                                    <TextBlock Text="{Binding Route}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,13"
                                    Background="{StaticResource Surface2}" CornerRadius="7" Padding="10,5" ToolTip="{Binding ChecksumTip}"
                                    Visibility="{Binding ShowChecksum, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding ChecksumGlyph}" FontSize="12" Foreground="{Binding ChecksumBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding ChecksumText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding ChecksumBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="%" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,14"/>
                                <TextBlock Text="{Binding ElapsedText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="16,0,0,17"/>
                            </StackPanel>

                            <!-- progress bar -->
                            <Grid Grid.Row="2" Height="10" Margin="0,2,0,0" x:Name="BarHost">
                                <Border CornerRadius="5" Background="{StaticResource Surface3}"/>
                                <Border x:Name="BarFill" CornerRadius="5" Background="{StaticResource AccentH}" HorizontalAlignment="Left" Width="0">
                                    <Border.Effect><DropShadowEffect Color="#4060FF" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                                </Border>
                            </Grid>

                            <!-- stat tiles -->
                            <UniformGrid Grid.Row="3" Columns="2" Rows="2" Margin="-5,18,-5,0">
                                <UniformGrid.Resources>
                                    <Style TargetType="Border" x:Key="Tile">
                                        <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        <Setter Property="CornerRadius" Value="11"/>
                                        <Setter Property="Padding" Value="14,11"/>
                                        <Setter Property="Margin" Value="5"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="SPEED" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding SpeedText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding SpeedSub}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding EtaLabel}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding EtaText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Tuning}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tuning}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="DATA" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding BytesText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding BytesSub}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="FILES" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding FilesText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding FilesSub}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- speed graph or error list -->
                            <Grid Grid.Row="4" Margin="0,12,0,0" MinHeight="90">
                                <Border CornerRadius="11" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Canvas x:Name="Graph" ClipToBounds="True" SizeChanged="Graph_SizeChanged">
                                            <Polygon x:Name="GraphFill">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#664060FF" Offset="0"/>
                                                        <GradientStop Color="#004060FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>
                                            <Polyline x:Name="GraphLine" Stroke="{StaticResource AccentH}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Canvas>
                                        <TextBlock Text="LIVE THROUGHPUT" Style="{StaticResource Caption}" Margin="12,9,0,0" Foreground="{StaticResource Faint}"/>
                                        <!-- errors overlay -->
                                        <DockPanel Background="{StaticResource Bg}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}" x:Name="ErrorsPanel">
                                            <DockPanel DockPanel.Dock="Top" Margin="12,9,8,4">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11" Click="CopyErrors_Click" Content="Copy list"/>
                                                <TextBlock Text="PROBLEMS" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ListBox ItemsSource="{Binding Errors}" Style="{StaticResource PlainList}" Margin="4,0,4,4">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Path}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="5" Text="{Binding CurrentFile}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="2,12,0,0" ToolTip="{Binding CurrentFile}"/>

                            <!-- controls -->
                            <Grid Grid.Row="6" Margin="0,14,0,0">
                                <UniformGrid Columns="2" Visibility="{Binding ShowRunControls, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource GhostButton}" Click="Pause_Click" Margin="0,0,5,0" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding PauseGlyph}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PauseLabel}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="5,0,0,0" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Danger}"/>
                                            <TextBlock Text="Cancel"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <UniformGrid Columns="2" Visibility="{Binding ShowDoneControls, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource GhostButton}" Click="OpenDestination_Click" Margin="0,0,5,0" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open destination"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Click="NewJob_Click" Margin="5,0,0,0" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="New job"/>
